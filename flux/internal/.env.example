# Environment
FLUX_ENV=development
FLUX_LOG_LEVEL=info

# PostgreSQL
FLUX_DB_HOST=localhost
FLUX_DB_PORT=5432
FLUX_DB_NAME=flux
FLUX_DB_USER=flux
FLUX_DB_PASSWORD=change-me-locally
FLUX_DB_SSLMODE=disable

# Kraken
FLUX_KRAKEN_BASE_URL=https://api.kraken.com
FLUX_KRAKEN_TIMEOUT_SECONDS=15

# Flux
FLUX_WORKER_COUNT=3
FLUX_CANDLE_CLOSE_DELAY_SECONDS=10
FLUX_HISTORY_START=
